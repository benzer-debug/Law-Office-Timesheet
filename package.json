{
  "name": "law-office-apps",
  "version": "1.0.0",
  "description": "Law Office Timesheet and Admin App",
  "main": "index.html",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "build": "mkdir -p public && cp -r index.html daily.html profile.html firebaseConfig.js rbac.js validation.js sessionTimeout.js public/ 2>/dev/null || true",
    "serve": "firebase serve",
    "start": "firebase serve",
    "deploy:firebase": "firebase deploy --token $FIREBASE_TOKEN"
  },
  "keywords": [
    "law-office",
    "timesheet",
    "admin",
    "firebase"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@eslint/js": "^9.0.0",
    "@firebase/testing": "^0.20.11",
    "babel-jest": "^30.0.0",
    "eslint": "^9.0.0",
    "eslint-config-google": "^0.14.0",
    "firebase-tools": "^15.7.0",
    "globals": "^15.0.0",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1"
  },
  "dependencies": {
    "firebase": "^12.9.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
