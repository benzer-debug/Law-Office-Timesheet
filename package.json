{
  "name": "law-office-apps",
  "version": "1.0.0",
  "description": "Law Office Timesheet and Admin App",
  "main": "index.html",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "build": "firebase deploy",
    "serve": "firebase serve",
    "start": "firebase serve"
  },
  "keywords": [
    "law-office",
    "timesheet",
    "admin",
    "firebase"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@firebase/testing": "^0.20.11",
    "eslint": "^8.56.0",
    "eslint-config-google": "^0.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "identity-obj-proxy": "^3.0.0",
    "firebase-tools": "^13.5.0"
  },
  "dependencies": {
    "firebase": "^12.9.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": ["eslint --fix", "prettier --write"],
    "*.html": ["prettier --write"],
    "*.json": ["prettier --write"]
  }
}
