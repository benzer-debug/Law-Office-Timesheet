service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for role-based access
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isManager() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }
    
    function isEmployee() {
      return isAuthenticated();
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function canManageUser(userId) {
      return isOwner(userId) || isAdmin() || (isManager() && isTeamMember(userId));
    }
    
    function isTeamMember(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userDoc.teamId != null && 
             get(/databases/$(database)/documents/users/$(userId)).data.teamId == userDoc.teamId;
    }

    function isOwnerFromField(data) {
      return isAuthenticated() &&
             (data.userId == request.auth.uid || data.uid == request.auth.uid);
    }

    function validDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function validTime(value) {
      return value is string && value.matches('^([01]\\d|2[0-3]):([0-5]\\d)(:[0-5]\\d)?$');
    }

    function validDailyLogPayload(data) {
      return data.keys().hasAll(['uid', 'date', 'timeIn']) &&
             data.uid is string &&
             data.uid == request.auth.uid &&
             validDate(data.date) &&
             validTime(data.timeIn) &&
             (!('timeOut' in data) || data.timeOut == null || validTime(data.timeOut)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 250)) &&
             (!('userId' in data) || data.userId == request.auth.uid);
    }

    function validMonthlyRecordPayload(data) {
      return data.keys().hasAll(['uid', 'month', 'year', 'monthKey', 'totalHours', 'daysWorked']) &&
             data.uid is string &&
             data.uid == request.auth.uid &&
             data.month is string && data.month.matches('^(0[1-9]|1[0-2])$') &&
             data.year is int && data.year >= 2000 && data.year <= 2100 &&
             data.monthKey is string && data.monthKey.matches('^\\d{4}-(0[1-9]|1[0-2])$') &&
             data.totalHours is number && data.totalHours >= 0 &&
             data.daysWorked is int && data.daysWorked >= 0 && data.daysWorked <= 31 &&
             (!('userId' in data) || data.userId == request.auth.uid);
    }

    function validTimesheetPayload(data, userId) {
      return data.keys().hasAll([
               'uid',
               'empName',
               'startDate',
               'endDate',
               'dailyRate',
               'otMultiplier',
               'timesheetData',
               'totalAmount',
               'savedAt'
             ]) &&
             data.keys().hasOnly([
               'uid',
               'empName',
               'startDate',
               'endDate',
               'dailyRate',
               'otMultiplier',
               'timesheetData',
               'salaryAdvances',
               'incentives',
               'bonuses',
               'totalAdvances',
               'totalIncentives',
               'totalBonuses',
               'totalAmount',
               'savedAt'
             ]) &&
             data.uid is string &&
             data.uid == userId &&
             data.empName is string && data.empName.size() > 0 && data.empName.size() <= 120 &&
             validDate(data.startDate) &&
             validDate(data.endDate) &&
             data.startDate <= data.endDate &&
             data.dailyRate is number && data.dailyRate >= 0 && data.dailyRate <= 1000000 &&
             data.otMultiplier is number && data.otMultiplier >= 1 && data.otMultiplier <= 10 &&
             data.timesheetData is list && data.timesheetData.size() <= 62 &&
             (!('salaryAdvances' in data) || (data.salaryAdvances is list && data.salaryAdvances.size() <= 50)) &&
             (!('incentives' in data) || (data.incentives is list && data.incentives.size() <= 50)) &&
             (!('bonuses' in data) || (data.bonuses is list && data.bonuses.size() <= 50)) &&
             (!('totalAdvances' in data) || (data.totalAdvances is number && data.totalAdvances >= 0 && data.totalAdvances <= 100000000)) &&
             (!('totalIncentives' in data) || (data.totalIncentives is number && data.totalIncentives >= 0 && data.totalIncentives <= 100000000)) &&
             (!('totalBonuses' in data) || (data.totalBonuses is number && data.totalBonuses >= 0 && data.totalBonuses <= 100000000)) &&
             data.totalAmount is number && data.totalAmount >= -100000000 && data.totalAmount <= 100000000 &&
             data.savedAt is timestamp;
    }

    function hasPrivilegedTitle(data) {
      return ('position' in data) &&
             data.position is string &&
             data.position.matches('.*([Mm]anager|[Aa]dmin).*');
    }

    function nonAdminEmployeeUpdateAllowed(oldData, newData) {
      return !newData.diff(oldData).affectedKeys().hasAny(['role', 'teamId']) &&
             (!newData.diff(oldData).affectedKeys().hasAny(['hasTimesheets']) ||
               (('hasTimesheets' in newData) &&
                newData.hasTimesheets is bool &&
                newData.hasTimesheets == true &&
                (!('hasTimesheets' in oldData) || oldData.hasTimesheets == true))) &&
             !hasPrivilegedTitle(newData);
    }

    function hasTimesheetsFlag(userId) {
      return exists(/databases/$(database)/documents/employees/$(userId)) &&
             get(/databases/$(database)/documents/employees/$(userId)).data.hasTimesheets == true;
    }

    function managerRoleAssignmentAllowed(oldData, newData, userId) {
      return !(
        ('role' in newData) &&
        newData.role == 'manager' &&
        (!('role' in oldData) || oldData.role != 'manager') &&
        hasTimesheetsFlag(userId)
      );
    }

    // Users collection - roles defined here
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isManager();
      allow create: if isAdmin();
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'teamId']);
      allow update: if isAdmin() && managerRoleAssignmentAllowed(resource.data, request.resource.data, userId);
      allow delete: if isAdmin();
    }

    // Employees collection
    match /employees/{userId} {
      allow read: if canManageUser(userId);
      allow create: if isAdmin();
      allow update: if isAdmin() && managerRoleAssignmentAllowed(resource.data, request.resource.data, userId);
      allow update: if canManageUser(userId) && nonAdminEmployeeUpdateAllowed(resource.data, request.resource.data);
      allow delete: if isAdmin();
      
      // Timesheets subcollection
      match /timesheets/{sheetId} {
        allow read: if canManageUser(userId);
        allow create: if canManageUser(userId) && validTimesheetPayload(request.resource.data, userId);
        allow update: if canManageUser(userId) && validTimesheetPayload(request.resource.data, userId);
        allow delete: if isAdmin() || isOwner(userId);
      }
      
      // Time-ins subcollection
      match /timeins/{timeInId} {
        allow read: if canManageUser(userId);
        allow create: if canManageUser(userId);
        allow update: if canManageUser(userId);
        allow delete: if isAdmin();
      }
    }

    // Usernames collection - for username availability checks
    match /usernames/{username} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Timesheets collection (root level)
    match /timesheets/{timesheetId} {
      allow read, write: if isAdmin() || 
                          (isEmployee() && resource.data.userId == request.auth.uid);
      allow create: if isEmployee() && request.resource.data.userId == request.auth.uid;
    }

    // Daily logs collection
    match /daily_logs/{logId} {
      allow read: if isAdmin() || isManager() ||
                      (isEmployee() && isOwnerFromField(resource.data));
      allow create: if isEmployee() && validDailyLogPayload(request.resource.data);
      allow update: if (isAdmin() || isOwnerFromField(resource.data)) &&
                       validDailyLogPayload(request.resource.data);
      allow delete: if isAdmin() || isOwnerFromField(resource.data);
    }

    // Monthly records collection
    match /monthly_records/{recordId} {
      allow read: if isAdmin() || isManager() ||
                      (isEmployee() && isOwnerFromField(resource.data));
      allow create: if isEmployee() && validMonthlyRecordPayload(request.resource.data);
      allow update: if (isAdmin() || isOwnerFromField(resource.data)) &&
                       validMonthlyRecordPayload(request.resource.data);
      allow delete: if isAdmin() || isOwnerFromField(resource.data);
    }
  }
}